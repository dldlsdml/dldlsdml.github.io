---
import {getAllPosts} from "../utils/getAllPosts";
import getUniqueTags from "../utils/getUniqueTags";
import getCountByCategory from "../utils/getCountByCategory";
import {t} from '../i18n/utils'

const blogs = await getAllPosts()
const tagArr = getUniqueTags(blogs);
const categoryCount = getCountByCategory(blogs);
---

<div>
  {
    Object.keys(categoryCount).length > 0 && (
      <div class="aside-widget justify-center">
        <i class="ri-folder-3-line menu-icon"/>{t('sidebar.categories')}
      </div>
    )
  }
  <div class="flex flex-wrap justify-center">
    {
      Object.keys(categoryCount).map((category) => (
        <a
          class="inline-block truncate m-1 border px-2 py-1 text-sm rounded hover:text-skin-active"
          title={category + " (" + categoryCount[category] + ")"}
          href={"/category/" + category}
        >
          {(category === 'uncategorized' ? t('sidebar.uncategorized') : category) + " (" + categoryCount[category] + ")"}
        </a>
      ))
    }
  </div>
</div>

<div class="mt-10">
  {
    tagArr.length > 0 && (
      <div class="aside-widget justify-center">
        <i class="ri-hashtag menu-icon"/>{t('sidebar.tags')}
      </div>
    )
  }
  <div class="flex flex-wrap justify-center">
    {
      tagArr.map((tag) =>
        <a class="inline-block truncate m-1 border px-2 py-1 text-sm rounded hover:text-skin-active" title={tag} href={"/tags/" + tag}>{tag}</a>
      )
    }
  </div>
</div>
