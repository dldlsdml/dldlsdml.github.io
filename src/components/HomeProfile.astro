---
import {site, infoLinks} from "../consts";
const intro = site.intro ?? [];
---

<section class="flex flex-col items-center text-center gap-6">
  <img src={site.avatar} alt="avatar" class="home-avatar" />

  <h1 class="font-title text-4xl sm:text-5xl uppercase tracking-wide">{site.motto}</h1>

  {
    intro.length > 0 && (
      <div class="max-w-md space-y-2 leading-relaxed">
        {intro.map((line) => <p>{line}</p>)}
      </div>
    )
  }

  <div class="flex flex-wrap justify-center gap-3 font-side">
    {
      infoLinks.map((item) => (
        <a
          class="home-btn"
          title={item.name}
          href={item.outlink}
          target={item.outlink.startsWith('http') ? '_blank' : '_self'}
        >
          <i class={item.icon} />
          <span>{item.name}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #EEECE7;
    border: 2px solid rgb(var(--color-text-active));
    box-shadow: 0 0 18px rgba(var(--color-text-active), 0.5);
  }

  .home-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .home-btn:hover {
    color: rgb(var(--color-text-active));
    border-color: rgb(var(--color-text-active));
    box-shadow: 0 0 12px rgba(var(--color-text-active), 0.45);
    transform: translateY(-2px);
  }
</style>
