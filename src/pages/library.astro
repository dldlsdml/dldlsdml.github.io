---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeAside from '../components/HomeAside.astro'
import {config} from "../consts";
---

<html lang={config.lang}>
<BaseHead title="Library | SEOYUN YI"/>

<body class="bg-skin-secondary relative">
<Header/>
<main class="container p-4 pt-24 text-skin-base pb-32 min-h-full relative" id="app">
  <div class="lib mx-auto w-full max-w-3xl space-y-8">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold">Library</h1>
      <p class="opacity-80">Everything I've written, sorted by category and tag.</p>
    </div>
    <div class="font-side"><HomeAside></HomeAside></div>
  </div>
  <Footer/>
</main>
</body>
<script>
  document.body.querySelectorAll("a").forEach(item => {
    item.setAttribute("rel", "nofollow noreferrer");
  });
</script>

<style>
  .lib :global(.justify-center) {
    justify-content: flex-start;
  }
</style>
</html>
